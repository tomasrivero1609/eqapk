# Plantilla de variables para el stack de eqapk en el VPS.
# Copiar a `.env` (junto al docker-compose.yml) y completar.  NO commitear el .env real.

# ── Postgres (eqapk-db) ───────────────────────────────────────────────────────
POSTGRES_USER=eqapk
POSTGRES_PASSWORD=cambiar_por_una_password_fuerte

# ── Backend ───────────────────────────────────────────────────────────────────
# Generar uno nuevo, p.ej.: openssl rand -base64 48
JWT_SECRET=cambiar_por_un_secret_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# ── Google Calendar (opcional) ────────────────────────────────────────────────
# Dejar en false hasta tener las credenciales cargadas.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID_SALON=
GOOGLE_CALENDAR_ID_VISITAS=
GOOGLE_CALENDAR_ID_FRANCO=
GOOGLE_CLIENT_EMAIL=
# La private key va en una sola linea con \n literales (igual que en Render).
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_TIMEZONE=America/Argentina/Buenos_Aires
