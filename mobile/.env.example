# Emulador Android: el emulador mapea 10.0.2.2 al localhost del PC donde corre Metro/Nest.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Teléfono físico mismo Wi‑Fi: reemplazar por tu IPv4 (ipconfig).
# EXPO_PUBLIC_API_URL=http://192.168.0.216:3000

# Expo Web en el mismo PC que el backend:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
